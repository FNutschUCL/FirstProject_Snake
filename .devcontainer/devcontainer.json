{
  "name": "Snake - your first project",
  "image": "mcr.microsoft.com/devcontainers/universal:2-linux",
  "customizations": {
    "vscode": {
      "extensions": [
        "saoudrizwan.claude-dev"
      ],
      "settings": {
        "workbench.startupEditor": "none",
        "editor.minimap.enabled": false,
        "editor.fontSize": 15,
        "editor.wordWrap": "on",
        "explorer.compactFolders": false,
        "workbench.colorTheme": "Default Dark Modern",
        "git.openRepositoryInParentFolders": "never",
        "terminal.integrated.environmentChangesRelaunch": false
      }
    }
  },
  "forwardPorts": [
    8080
  ],
  "portsAttributes": {
    "8080": {
      "label": "Your game",
      "onAutoForward": "silent"
    }
  },
  "postAttachCommand": "nohup python3 ${containerWorkspaceFolder}/serve.py > /tmp/server.log 2>&1 & code --install-extension ${containerWorkspaceFolder}/.devcontainer/course-panel-0.4.0.vsix --force > /dev/null 2>&1 || true",
  "remoteUser": "codespace",
  "postCreateCommand": "code --install-extension ${containerWorkspaceFolder}/.devcontainer/course-panel-0.4.0.vsix --force || true"
}
